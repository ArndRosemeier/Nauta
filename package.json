{
  "name": "nauta",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Ship battles commanded from the deck: you give the orders, the crew sails and fights the ship.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test/run.mjs",
    "dup": "node tools/duplicate-candidates/find-duplicate-candidates.mjs",
    "repeated": "node tools/repeated-code/find-repeated-code.mjs",
    "shot": "node tools/shot/shot.mjs",
    "guards": "node tools/guards/guards.mjs",
    "check:replay": "tsx tools/sim/replay.ts",
    "check:sailing": "tsx tools/sim/sailing.ts",
    "check:crew": "tsx tools/sim/crew.ts",
    "check:gunnery": "tsx tools/sim/gunnery.ts",
    "check:captains": "tsx tools/sim/captains.ts",
    "plan:draw": "tsx tools/plan/draw.ts",
    "shot:sea": "node tools/shot/sea.mjs",
    "check:shots": "node tools/shot/check.mjs",
    "shot:probe": "node tools/shot/probe.mjs",
    "check:ship": "node tools/shot/ship.mjs",
    "shot:sails": "node tools/shot/sails.mjs",
    "shot:glass": "node tools/shot/glass.mjs",
    "shot:guns": "node tools/shot/guns.mjs",
    "shot:title": "node tools/shot/title.mjs",
    "walk:check": "tsx tools/walk/everywhere.ts",
    "check:room": "node tools/net/room.mjs",
    "packs": "node tools/crew/pack.mjs",
    "shot:ui": "node tools/shot/ui.mjs",
    "shot:speech": "node tools/shot/speech.mjs",
    "shot:fan": "node tools/shot/fan.mjs"
  },
  "dependencies": {
    "@actors/core": "https://github.com/ArndRosemeier/Actors/releases/download/v0.37.0/actors-core-0.37.0.tgz",
    "@actors/generator": "https://github.com/ArndRosemeier/Actors/releases/download/v0.37.0/actors-generator-0.37.0.tgz",
    "@actors/human": "https://github.com/ArndRosemeier/Actors/releases/download/v0.37.0/actors-human-0.37.0.tgz",
    "@actors/three": "https://github.com/ArndRosemeier/Actors/releases/download/v0.37.0/actors-three-0.37.0.tgz",
    "@futuremagic/audio": "file:vendor/assetgenerator/packages/audio",
    "@futuremagic/core": "file:vendor/assetgenerator/packages/core",
    "@futuremagic/deck": "file:vendor/assetgenerator/packages/deck",
    "@futuremagic/figure": "file:vendor/assetgenerator/packages/figure",
    "@futuremagic/instances": "file:vendor/assetgenerator/packages/instances",
    "@futuremagic/props": "file:vendor/assetgenerator/packages/props",
    "@futuremagic/sky": "file:vendor/assetgenerator/packages/sky",
    "@futuremagic/stage": "file:vendor/assetgenerator/packages/stage",
    "@futuremagic/texgen": "file:vendor/assetgenerator/packages/texgen",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
